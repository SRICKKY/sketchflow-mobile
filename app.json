{
  "expo": {
    "name": "SketchFlow",
    "slug": "sketchflow-mobile",
    "scheme": "sketchflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.sketchflow.mobile"
    },
    "android": {
      "package": "online.sketchflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2dd4bf",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-mark.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#f3fbf9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
